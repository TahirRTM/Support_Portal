# ---- Runtime ----
ENVIRONMENT=development
DEBUG=true

# ---- Security (generate strong values for production!) ----
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_SECRET=dev-access-secret-not-for-prod-000000
REFRESH_TOKEN_SECRET=dev-refresh-secret-not-for-prod-00000

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/aisupport

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Trusted proxy / client IP ----
TRUST_FORWARDED_HEADERS=true
TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# ---- Rate limiting ----
TICKET_CREATE_LIMIT=3
TICKET_CREATE_WINDOW_SECONDS=300

# ---- OTP ----
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---- Cloudflare Turnstile ----
TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000

# ---- AI provider ----
AI_ENABLED=true
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ---- Email (SMTP) ----
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=support@example.com

# ---- WhatsApp ----
WHATSAPP_PROVIDER=meta
WHATSAPP_API_KEY=
WHATSAPP_FROM=

# ---- Pushover ----
PUSHOVER_TOKEN=
PUSHOVER_USER_KEY=

# ---- Storage ----
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=/var/lib/aisupport/attachments
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1

# ---- ClamAV ----
CLAMAV_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ---- Admin bootstrap (used by seed only) ----
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
